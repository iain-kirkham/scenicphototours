---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const tours = await getCollection("tours");

  return tours.map((tour) => ({
    params: { slug: tour.id },
    props: { tour },
  }));
}

const { tour } = Astro.props;

const {
  title,
  subtitle,
  image,
  date,
  time,
  duration,
  meetingPoint,
  whatToBring,
} = tour.data;
---

<Layout title={title}>
  <section class="w-full bg-background text-primary">
    <!-- Hero Banner: image with title overlaid -->
    <div class="relative h-56 w-full overflow-hidden md:h-72 lg:h-80">
      <Image
        src={image}
        alt={title}
        width={1600}
        height={800}
        class="absolute inset-0 h-full w-full object-cover"
      />
      <!-- Gradient overlay for text legibility -->
      <div
        class="absolute inset-0 bg-gradient-to-t from-background via-background/40 to-transparent"
      >
      </div>

      <div class="absolute bottom-0 left-0 w-full px-6 py-6 md:px-10 md:py-8">
        <p class="text-xs font-medium uppercase tracking-widest text-secondary">
          Available Tour
        </p>
        <h1
          class="mt-1 text-2xl font-light uppercase tracking-wider text-primary md:text-4xl"
        >
          {title}
        </h1>
        <p class="mt-2 max-w-xl text-sm text-secondary md:text-base">
          {subtitle}
        </p>
      </div>
    </div>

    <!-- Main content -->
    <div class="mx-auto max-w-5xl px-6 py-10">
      <div class="grid gap-8 md:grid-cols-[2fr_1fr]">
        <!-- What to bring -->
        <div>
          {
            whatToBring && whatToBring.length > 0 && (
              <div>
                <h2 class="text-lg font-semibold uppercase tracking-wide text-primary">
                  What to Bring
                </h2>
                <ul class="mt-3 space-y-2 text-sm text-secondary">
                  {whatToBring.map((item) => (
                    <li class="flex items-start gap-2">
                      <span class="mt-0.5 text-accent">•</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>

        <!-- Quick facts sidebar -->
        <aside
          class="h-fit rounded-xl border border-secondary/25 bg-surface p-6 md:sticky md:top-24"
        >
          <h2
            class="text-sm font-semibold uppercase tracking-wide text-primary"
          >
            Tour Details
          </h2>
          <dl class="mt-4 space-y-3 text-sm">
            {
              date && (
                <div>
                  <dt class="text-secondary">Date</dt>
                  <dd class="text-primary">{date}</dd>
                </div>
              )
            }
            {
              time && (
                <div>
                  <dt class="text-secondary">Time</dt>
                  <dd class="text-primary">{time}</dd>
                </div>
              )
            }
            {
              duration && (
                <div>
                  <dt class="text-secondary">Duration</dt>
                  <dd class="text-primary">{duration}</dd>
                </div>
              )
            }
            {
              meetingPoint && (
                <div>
                  <dt class="text-secondary">Meeting Point</dt>
                  <dd class="text-primary">{meetingPoint}</dd>
                </div>
              )
            }
          </dl>
          <a
          href="/contact" class="mt-6 inline-flex w-full items-center
          justify-center rounded-lg bg-accent px-4 py-3 text-sm font-semibold
          text-background transition-colors hover:bg-white" > Reserve Your Spot
        </a>
        </aside>
      </div>
    </div>
  </section></Layout
>
