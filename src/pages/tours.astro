---
import { Image } from "astro:assets";

// Props passed in from the parent (Tours page)
// `image` may be either:
//   - a string URL (from older data sources)
//   - an imported ImageMetadata object (from Astro content collections)
const { title, subtitle, image, href } = Astro.props;

// Determine whether the image is a plain string or an Astro image object.
// This allows the component to support both formats without breaking.
const isStringImage = typeof image === "string";
---

<article class="tour-card">
  <div class="tour-card-media">
    {
      // If `image` is a string, render a normal <img>.
      // Useful when images come from external URLs or older data structures.
      isStringImage ? (
        <img src={image} alt={title} class="tour-card-image" />
      ) : (
        // If `image` is an Astro ImageMetadata object, use <Image />.
        // This enables automatic optimization, responsive sizes, and lazy loading.
        <Image
          src={image}
          alt={title}
          class="tour-card-image"
          widths={[320, 480, 640]}
          sizes="(min-width: 1440px) 18vw,
                 (min-width: 1200px) 22vw,
                 (min-width: 900px) 28vw,
                 (min-width: 640px) 46vw,
                 92vw"
        />
      )
    }
  </div>

  <div class="tour-card-content">
    <!-- Eyebrow label for visual hierarchy -->
    <p class="tour-card-eyebrow">Available Tour</p>

    <!-- Title and subtitle pulled from Markdown frontmatter -->
    <h3>{title}</h3>
    <p>{subtitle}</p>

    <!-- CTA button linking to the contact page -->
    <!-- Scoped to .tour-card so it overrides any global .cta-button styling -->
    <a href="/contact" class="cta-button">Reserve Your Spot</a>
  </div>
</article>

<style>
  /*
    NOTE: These styles used to live in the parent page's stylesheet,
    but Astro scopes styles per-component (via a data-astro-cid attribute).
    Since .tour-card and its children are rendered here, not in the parent,
    the styles have to live here too or they never actually apply.
  */

  .tour-card {
    background: #161c22;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%; /* fills the grid cell — pairs with grid-auto-rows: 1fr on .tour-grid for uniform card heights */
  }

  .tour-card-media {
    height: 3.5rem;
    background: #101418;
  }

  .tour-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .tour-card-content {
    flex: 1;
    display: grid;
    gap: 0.35rem;
    padding: 0.45rem 0.55rem 0.55rem;
  }

  .tour-card-eyebrow {
    color: #607d8b;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.6rem;
    margin: 0;
  }

  .tour-card h3 {
    font-size: 0.85rem;
    line-height: 1.15;
    margin: 0;
  }

  .tour-card p {
    color: #c7d0d6;
    font-size: 0.66rem;
    line-height: 1.4;
    margin: 0;
  }

  .tour-card .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    background: #e0e0e0;
    color: #101418;
    text-decoration: none;
    border: 0;
    border-radius: 6px;
    padding: 0.5rem 0.65rem;
    font-weight: 600;
    cursor: pointer;
    font-size: 0.66rem;
  }

  /* Slightly tighter spacing/type at desktop sizes so the whole card
     (image + text + button) fits without scrolling on a 1024px viewport */
  @media (min-width: 1024px) {
    .tour-card-media {
      height: 2.75rem;
    }

    .tour-card-content {
      padding: 0.35rem 0.45rem 0.45rem;
      gap: 0.2rem;
    }

    .tour-card-eyebrow {
      font-size: 0.55rem;
    }

    .tour-card h3 {
      font-size: 0.82rem;
    }

    .tour-card p {
      font-size: 0.64rem;
      line-height: 1.35;
    }

    .tour-card .cta-button {
      padding: 0.4rem 0.55rem;
      font-size: 0.62rem;
    }
  }
</style>
