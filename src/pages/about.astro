---
import Testimonials from "../components/Testimonials.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="About Us | Scenic Photo Tours">
  <main class="w-full bg-background text-primary">
    <!-- Story / Mission Section -->
    <section class="max-w-4xl mx-auto pt-[6vh] pb-[4vh] px-6 3xl:max-w-5xl">
      <h1 class="text-3xl font-light tracking-widest uppercase md:text-4xl text-primary mb-6">
        About Our Expeditions
      </h1>

      <div class="space-y-4 text-sm leading-relaxed text-secondary">
        <p>
          Scenic Photo Tours was founded on a passion for capturing raw, untouched landscapes under peak lighting conditions. We specialize in small-group photography workshops focused on immersive outdoor experiences.
        </p>
        <p>
          Whether scouting coastal fjords or tracking northern auroras, our goal is to get you to the right locations at the exact right moment, helping you refine your technical skills while discovering unforgettable terrain.
        </p>
      </div>
    </section>

    <!-- Explorer Reviews Section -->
    <Testimonials />
  </main>
</Layout>