---
const { image, title, subtitle, buttonText, ctaHref } = Astro.props;
---

<section
  class="relative w-full min-h-[45vh] bg-cover bg-top bg-no-repeat flex items-center justify-center px-4 py-10 sm:min-h-[40vh] sm:py-12 sm:items-center sm:px-6 sm:bg-center md:min-h-[50vh] md:py-16 before:absolute before:inset-0 before:bg-black/55"
  style={`background-image: url(${image})`}
>
  <div class="relative z-10 w-full max-w-2xl text-center sm:text-left text-slate-100">
    <h1 class="text-2xl sm:text-xl md:text-3xl leading-tight mb-3 sm:mb-2 font-normal">
      {title}
    </h1>
    <p class="text-sm sm:text-xs md:text-sm mb-3 sm:mb-2 text-slate-300">
      {subtitle}
    </p>
    <a
      href={ctaHref}
      class="inline-block bg-slate-200 text-slate-900 px-4 py-2 rounded transition-colors duration-200 hover:bg-slate-300 font-semibold text-sm"
    >
      {buttonText}
    </a>
  </div>
</section>
