---
const { image, title, subtitle, buttonText, ctaHref } = Astro.props;
---

<section class="hero" style={`background-image: url(${image})`}>
  <div class="overlay"></div>

  <div class="content">
    <h1>{title}</h1>
    <p>{subtitle}</p>
    <a href={ctaHref} class="cta">{buttonText}</a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: clamp(26rem, 62vh, 46rem);
    padding: clamp(1.5rem, 4vw, 3.5rem) 0;
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  .overlay {
    position: absolute;
    inset: 0;
    background: rgba(16, 20, 24, 0.55);
  }

  .content {
    position: relative;
    text-align: center;
    color: #F5F5F5;
    width: min(100%, 700px);
    padding: clamp(0.5rem, 2vw, 1.5rem) 24px 0;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.05;
    margin-bottom: 12px;
  }

  p {
    font-size: clamp(1rem, 2vw, 1.3rem);
    margin-bottom: 24px;
    color: #E0E0E0;
  }

  .cta {
    display: inline-block;
    background: #E0E0E0;
    color: #101418;
    padding: 12px 24px;
    border-radius: 6px;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 600;
    transition: background 0.2s ease;
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 24rem;
      padding: 1rem 0 1.5rem;
      background-position: center top;
    }

    .content {
      padding-inline: 16px;
    }

    p {
      margin-bottom: 18px;
    }
  }

  .cta:hover {
    background: #cfcfcf;
  }
</style>
