---
import { getCollection } from "astro:content";

const testimonials = await getCollection("testimonials");
---

<section class="w-full bg-background py-[6vh] px-6 border-t border-secondary/20">
    <div class="max-w-6xl mx-auto 3xl:max-w-[1600px]">
        <!-- Header -->
        <div class="text-center mb-12">
            <h2 class="text-2xl font-light tracking-widest text-primary uppercase md:text-3xl">
                Explorer Reviews
            </h2>
            <p class="mt-2 text-xs text-secondary">
                Feedback from photographers who have joined our expeditions.
            </p>
        </div>

        <!-- Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 3xl:grid-cols-4">
            {testimonials.map((item) => (
                    <div class="flex flex-col justify-between bg-surface border border-secondary/25 rounded-xl p-6 shadow-md transition-colors hover:border-secondary/50">
                        <p class="text-xs italic text-primary leading-relaxed mb-6">
                            "{item.data.quote}"
                        </p>
                        <div class="pt-4 border-t border-secondary/15">
                            <p class="text-xs font-semibold tracking-wider text-primary uppercase">
                                {item.data.author}
                            </p>
                            {item.data.location && (
                                    <p class="text-[10px] tracking-wide text-secondary uppercase mt-0.5">
                                        {item.data.location}
                                    </p>
                            )}
                        </div>
                    </div>
            ))}
        </div>
    </div>
</section>