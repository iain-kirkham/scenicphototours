---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
	title: string;
	subtitle: string;
	image: ImageMetadata;
	href: string;
}

const { title, subtitle, image, href } = Astro.props;
---

<div class="group relative flex flex-col justify-between overflow-hidden bg-surface transition-colors duration-300 hover:bg-surface-hover">
  <div>
    <!-- Card Image -->
    <div class="h-44 w-full overflow-hidden">
      <Image
          src={image}
          alt={title}
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    </div>

    <!-- Card Content -->
    <div class="p-6">
      <h3 class="text-lg font-semibold tracking-wider text-primary uppercase">
        {title}
      </h3>
      <p class="mt-2 text-xs leading-relaxed text-secondary">
        {subtitle}
      </p>
    </div>
  </div>

  <!-- Card Action Link -->
  <div class="p-6 pt-0">
    <a
        href={href}
        class="inline-flex items-center text-xs font-medium tracking-widest text-secondary uppercase transition-colors group-hover:text-primary after:absolute after:inset-0"
    >
      LEARN MORE <span class="ml-1 transition-transform duration-300 group-hover:translate-x-1">→</span>
    </a>
  </div>
</div>