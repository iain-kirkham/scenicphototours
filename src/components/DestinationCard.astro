---
const { title, subtitle, image } = Astro.props;
---

<div class="card">
  <img src={image} alt={title} />

  <div class="content">
    <h3>{title}</h3>
    <p>{subtitle}</p>
    <a href="#" class="learn">Learn More →</a>
  </div>
</div>

<style>
  .card {
    background: #101418;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid #1a1f24;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.5);
  }

  img {
    width: 100%;
    height: 180px;
    object-fit: cover;
  }

  .content {
    padding: 20px;
    color: #f5f5f5;
  }

  h3 {
    margin-bottom: 8px;
    font-size: 1.3rem;
  }

  p {
    margin-bottom: 16px;
    color: #607d8b;
  }

  .learn {
    color: #e0e0e0;
    text-decoration: none;
    font-weight: 500;
  }

  .learn:hover {
    text-decoration: underline;
  }
</style>
