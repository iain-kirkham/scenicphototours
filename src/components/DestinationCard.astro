---
interface Props {
  title: string;
  subtitle: string;
  image: string;
  href: string;
}

const { title, subtitle, image, href } = Astro.props;
---

<div class="group relative flex flex-col justify-between overflow-hidden bg-[#161c22] transition-colors duration-300 hover:bg-[#1f2730]">
  <div>
    <!-- Card Image -->
    <div class="h-44 w-full overflow-hidden">
      <img
          src={image}
          alt={title}
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    </div>

    <!-- Card Content -->
    <div class="p-6">
      <h3 class="text-lg font-semibold tracking-wider text-[#F5F5F5] uppercase">
        {title}
      </h3>
      <p class="mt-2 text-xs leading-relaxed text-[#607D8B]">
        {subtitle}
      </p>
    </div>
  </div>

  <!-- Card Action Link -->
  <div class="p-6 pt-0">
    <a
        href={href}
        class="inline-flex items-center text-xs font-medium tracking-widest text-[#607D8B] uppercase transition-colors group-hover:text-[#F5F5F5] after:absolute after:inset-0"
    >
      LEARN MORE <span class="ml-1 transition-transform duration-300 group-hover:translate-x-1">→</span>
    </a>
  </div>
</div>