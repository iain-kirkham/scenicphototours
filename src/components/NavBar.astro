---
import { links } from "../data/utils";

const currentPath = Astro.url.pathname;
---

<div
    class="nav-links flex flex-col items-center space-y-6 md:flex-row md:items-center md:space-y-0 md:space-x-6"
>
    {links.map((link) => {
        const isActive = currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href));
        return (
                <a
                        href={link.href}
                    class={`pb-0.5 text-xs uppercase font-medium leading-none transition-colors duration-200 border-b-2 ${
                            isActive
                                ? "text-primary border-secondary"
                                : "text-secondary border-transparent hover:text-primary hover:border-secondary/50"
                        }`}
                >
                    {link.text}
                </a>
        );
    })}
</div>