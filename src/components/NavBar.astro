---
import { links } from "../data/utils";

const currentPath = Astro.url.pathname;
---

<div
        class="nav-links flex flex-col items-center space-y-6 md:flex-row md:items-center md:space-y-0 md:space-x-8"
>
    {links.map((link) => {
        const isActive = currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href));
        return (
                <a
                        href={link.href}
                        class={`pb-1 text-xs uppercase font-medium transition-colors duration-200 border-b-2 ${
                            isActive
                                ? "text-[#F5F5F5] border-[#607D8B]"
                                : "text-[#607D8B] border-transparent hover:text-[#F5F5F5] hover:border-[#607D8B]/50"
                        }`}
                >
                    {link.text}
                </a>
        );
    })}
</div>