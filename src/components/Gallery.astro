---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

const imageFiles = import.meta.glob<{ default: ImageMetadata }>(
	"../assets/galleryImages/*.{jpg,jpeg,png,webp}",
	{ eager: true },
);

const images: ImageMetadata[] = Object.values(imageFiles).map(
	(file) => file.default,
);
---

<div id="gallery-container" class="w-full space-y-4">
    <!-- Main Display Window with Side Peeks -->
    <div class="relative flex h-125 w-full items-center justify-center overflow-hidden rounded-lg bg-surface">

        <!-- Left Navigation Button -->
        <button
                id="prev-btn"
                type="button"
                aria-label="Previous Image"
                class="absolute left-4 z-30 rounded-full bg-background/80 p-3 text-primary backdrop-blur-sm transition-colors hover:bg-secondary focus:outline-none cursor-pointer pointer-events-auto"
        >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
        </button>

        <!-- Viewport & Peeking Carousel Track -->
        <div id="main-image-viewport" class="relative z-10 flex h-full w-full items-center justify-center cursor-zoom-in">
            {images.map((img: ImageMetadata, index: number) => (
                    <div
                            class={`gallery-slide absolute flex h-full w-[85%] items-center justify-center transition-all duration-300 ease-out md:w-[75%] ${
                                index === 0
                                    ? "opacity-100 scale-100 z-20"
                                    : index === 1
                                        ? "opacity-30 scale-90 translate-x-[85%] z-10 blur-[1px]"
                                        : index === images.length - 1
                                            ? "opacity-30 scale-90 -translate-x-[85%] z-10 blur-[1px]"
                                            : "opacity-0 scale-90 z-0 pointer-events-none"
                            }`}
                            data-index={index}
                    >
                        <Image
                                src={img}
                                alt={`Gallery image ${index + 1}`}
                                class="h-full w-full object-contain pointer-events-none rounded-lg"
                                widths={[600, 900, 1200]}
                                sizes="(max-width: 1280px) 100vw, 1200px"
                                loading={index === 0 ? "eager" : "lazy"}
                        />
                    </div>
            ))}
        </div>

        <!-- Right Navigation Button -->
        <button
                id="next-btn"
                type="button"
                aria-label="Next Image"
                class="absolute right-4 z-30 rounded-full bg-background/80 p-3 text-primary backdrop-blur-sm transition-colors hover:bg-secondary focus:outline-none cursor-pointer pointer-events-auto"
        >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
        </button>
    </div>

    <!-- Thumbnails Row -->
    <div class="relative w-full">
        <div
                id="thumbnail-strip"
                class="flex space-x-3 overflow-x-auto py-2 scrollbar-thin scrollbar-thumb-secondary"
        >
            {images.map((img: ImageMetadata, index: number) => (
                    <button
                            type="button"
                            class={`thumb-btn relative h-20 w-28 shrink-0 overflow-hidden rounded-md border-2 transition-all cursor-pointer ${
                                index === 0 ? "border-secondary opacity-100" : "border-transparent opacity-50 hover:opacity-100"
                            }`}
                            data-index={index}
                    >
                        <Image
                                src={img}
                                alt={`Thumbnail ${index + 1}`}
                                class="h-full w-full object-cover"
                                width={120}
                                height={80}
                                loading="lazy"
                        />
                    </button>
            ))}
        </div>
    </div>

    <!-- Lightbox Modal Overlay -->
    <div
            id="lightbox-modal"
            class="fixed inset-0 z-50 hidden bg-black/90 flex items-center justify-center p-4 cursor-zoom-out"
    >
        <button
                id="close-lightbox"
                type="button"
                aria-label="Close Lightbox"
                class="absolute top-6 right-6 text-white text-4xl font-light hover:text-secondary focus:outline-none cursor-pointer"
        >
            &times;
        </button>
        <img
                id="lightbox-img"
                src=""
                alt="Enlarged scenic gallery view"
                class="max-h-[90vh] max-w-[90vw] object-contain rounded-lg shadow-2xl pointer-events-none"
        />
    </div>
</div>

<script>
    function setupGallery() {
        const prevBtn = document.getElementById("prev-btn");
        const nextBtn = document.getElementById("next-btn");
        const slides = document.querySelectorAll<HTMLElement>(".gallery-slide");
        const thumbs = document.querySelectorAll<HTMLButtonElement>(".thumb-btn");
        const mainViewport = document.getElementById("main-image-viewport");
        const lightboxModal = document.getElementById("lightbox-modal");
        const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement;
        const closeLightboxBtn = document.getElementById("close-lightbox");

        if (!slides.length) return;

        let currentIndex = 0;
        const total = slides.length;

        function render(index: number) {
            if (index < 0) currentIndex = total - 1;
            else if (index >= total) currentIndex = 0;
            else currentIndex = index;

            const prevIndex = (currentIndex - 1 + total) % total;
            const nextIndex = (currentIndex + 1) % total;

            // Pre-sync lightbox image source so opening the modal is instant
            const activeImg = slides[currentIndex]?.querySelector("img");
            if (activeImg && lightboxImg) {
                lightboxImg.src = activeImg.src;
            }

            slides.forEach((slide, i) => {
                // Reset positional transforms and blurs
                slide.classList.remove(
                    "opacity-100", "scale-100", "z-20", "pointer-events-auto",
                    "opacity-30", "scale-90", "z-10", "blur-[1px]", "translate-x-[85%]", "-translate-x-[85%]",
                    "opacity-0", "z-0", "pointer-events-none"
                );

                if (i === currentIndex) {
                    // Active center slide
                    slide.classList.add("opacity-100", "scale-100", "z-20", "pointer-events-auto");
                } else if (i === prevIndex) {
                    // Peek left slide
                    slide.classList.add("opacity-30", "scale-90", "-translate-x-[85%]", "z-10", "blur-[1px]", "pointer-events-auto");
                } else if (i === nextIndex) {
                    // Peek right slide
                    slide.classList.add("opacity-30", "scale-90", "translate-x-[85%]", "z-10", "blur-[1px]", "pointer-events-auto");
                } else {
                    // Offscreen hidden slides
                    slide.classList.add("opacity-0", "scale-90", "z-0", "pointer-events-none");
                }
            });

            thumbs.forEach((thumb, i) => {
                if (i === currentIndex) {
                    thumb.classList.add("border-secondary", "opacity-100");
                    thumb.classList.remove("border-transparent", "opacity-50");
                    thumb.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" });
                } else {
                    thumb.classList.remove("border-secondary", "opacity-100");
                    thumb.classList.add("border-transparent", "opacity-50");
                }
            });
        }

        // Initialize state & sync initial lightbox src
        render(0);

        if (prevBtn) {
            prevBtn.onclick = (e) => {
                e.stopPropagation();
                render(currentIndex - 1);
            };
        }

        if (nextBtn) {
            nextBtn.onclick = (e) => {
                e.stopPropagation();
                render(currentIndex + 1);
            };
        }

        thumbs.forEach((thumb) => {
            thumb.onclick = () => {
                const idx = Number.parseInt(thumb.getAttribute("data-index") || "0", 10);
                render(idx);
            };
        });

        // Click side peek images directly to navigate
        slides.forEach((slide) => {
            slide.onclick = (e) => {
                const idx = Number.parseInt(slide.getAttribute("data-index") || "0", 10);
                if (idx !== currentIndex) {
                    e.stopPropagation();
                    render(idx);
                }
            };
        });

        // Lightbox Open (Instant toggle since src is pre-synced)
        mainViewport?.addEventListener("click", () => {
            if (lightboxModal && lightboxImg?.src) {
                lightboxModal.classList.remove("hidden");
                lightboxModal.classList.add("flex");
            }
        });

        // Lightbox Close
        const closeLightbox = () => {
            if (lightboxModal) {
                lightboxModal.classList.remove("flex");
                lightboxModal.classList.add("hidden");
            }
        };

        lightboxModal?.addEventListener("click", closeLightbox);
        closeLightboxBtn?.addEventListener("click", closeLightbox);

        // Keyboard Navigation
        const handleKeyDown = (e: KeyboardEvent) => {
            if (["INPUT", "TEXTAREA"].includes((e.target as HTMLElement)?.tagName)) {
                return;
            }

            if (e.key === "Escape" && lightboxModal && !lightboxModal.classList.contains("hidden")) {
                closeLightbox();
            } else if (e.key === "ArrowLeft") {
                e.preventDefault();
                render(currentIndex - 1);
            } else if (e.key === "ArrowRight") {
                e.preventDefault();
                render(currentIndex + 1);
            }
        };

        window.removeEventListener("keydown", handleKeyDown);
        window.addEventListener("keydown", handleKeyDown);
    }

    setupGallery();
    document.addEventListener("astro:page-load", setupGallery);
</script>