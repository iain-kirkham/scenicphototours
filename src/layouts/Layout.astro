---
import "../styles/global.css";
import "../components/NavBar.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
	title?: string;
}

const { title = "Scenic Photo Tours" } = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<link rel="icon" href="/favicon.ico" />
	<meta name="generator" content={Astro.generator} />
	<title>{title}</title>
</head>
<body class="flex min-h-screen flex-col bg-background text-primary">
<Header />
		<main class="mx-auto w-full max-w-7xl grow px-6 py-[2vh] md:py-[3vh] 3xl:max-w-[1800px]">
	<slot />
</main>
<Footer />
</body>
</html>
